      "w": 11.35,
      "h": 22.61,
      "defaultTitle": "机组状态",
      "defaultSubtitle": "UNIT STATUS",
      "filterText": "模块机",
      "interfaces": [
        {
          "key": "scope",
          "name": "范围",
          "valueType": "scope",
          "allowedSources": [
