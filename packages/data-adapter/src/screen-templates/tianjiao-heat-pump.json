  "objectBinding": {
    "matchBy": "objectName",
    "description": "三维对象按 GLB 里的节点名对接。9 台模块机 node 为 1~9，泵为「立式管道离心泵」「立式管道离心泵_2」。只绑平台实时设备，虚拟设备按既有规则失效。",
    "fields": [
      {
        "key": "targetDevice",
        "name": "目标设备",
        "valueType": "realtime-device",
        "required": true
      },
      {
        "key": "nameplatePoints",
        "name": "铭牌测点",
        "valueType": "telemetry-mapping-list",
        "optional": true
      },
      {
        "key": "behaviors",
        "name": "行为",
        "valueType": "action-mapping-list",
        "optional": true
      },
      {
        "key": "controlCommands",
        "name": "启停命令",
        "valueType": "command-list",
        "optional": true
      },
      {
        "key": "status",
        "name": "状态映射",
        "valueType": "status-mapping",
        "optional": true
      }
    ]
  },
  "aiExtension": {
    "editableTargets": [
      "widget.props",
      "widget.layout",
      "widget.style",
      "widget.binding",
      "scene.interaction",
      "scene.layer"
    ],
    "protectedTargets": [
      "templateId",
      "mountPoints.scene",
      "runtime.eventContract"
    ],
    "operations": [
      "add-widget",
      "update-widget",
      "remove-widget",
      "bind-telemetry"
    ],
    "requiresDiffReview": true
  }
}