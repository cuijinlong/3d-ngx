      "y": 84.63,
      "w": 46.5,
      "h": 14.17,
      "defaultTitle": "机组总功率趋势",
      "defaultSubtitle": "POWER TREND",
      "interfaces": [
        {
          "key": "filter",
          "name": "取数范围",
