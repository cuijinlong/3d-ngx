{
  "schemaVersion": "1.0.0",
  "id": "tianjiao-heat-pump",
  "name": "天骄冷热站",
  "version": 23,
  "description": "热泵机组监控大屏：左翼场站用电量、场站用电趋势、用能分项占比；右翼碳排放核算、机组状态、告警跑马灯。",
  "regions": [
    {
      "id": "title",
      "type": "title",
      "zone": "title",
      "x": 20.0,
      "y": 1.0,
      "w": 60.0,
      "h": 6.5,
      "defaultTitle": "{sceneName} · 冷热站监控",
      "defaultSubtitle": "CHILLED WATER PLANT DIGITAL TWIN",
      "interfaces": []
    },
    {
      "id": "system-power",
      "type": "metric-card",
      "zone": "left",
      "x": 2.4,
      "y": 12.6,
      "w": 18.6,
      "h": 22,
      "defaultTitle": "系统功率",
      "defaultSubtitle": "SYSTEM POWER",
      "filterText": "模块机",
      "interfaces": [
        {
          "key": "filter",
          "name": "取数范围",
          "valueType": "scope",
          "allowedSources": [
            "site",
            "scene-topology"
          ]
        },
        {
          "key": "main",
          "name": "系统功率",
          "valueType": "number",
          "allowedSources": [
            "device-point"
          ]
        },
        {
          "key": "left",
          "name": "进水温度",
          "valueType": "number",
          "allowedSources": [
            "asset-attribute",
            "device-point"
          ]
        },
        {
          "key": "right",
          "name": "出水温度",
          "valueType": "number",
          "allowedSources": [
            "asset-attribute",
            "device-point"
          ]
        }
      ],
      "settings": {
        "dataSource": "energy",
        "energyMetric": "usage",
        "energyKind": "elec"
      }
    },
    {
      "id": "power-trend",
      "type": "trend-chart",
      "zone": "left",
      "x": 2.4,
      "y": 35.5,
      "w": 18.6,
      "h": 24,
      "defaultTitle": "机组总功率趋势",
      "defaultSubtitle": "POWER TREND",
      "interfaces": [
        {
          "key": "filter",
          "name": "取数范围",
          "valueType": "scope",
          "allowedSources": [
            "site",
            "scene-topology"
          ]
        },
        {
          "key": "series-0",
          "name": "9 台之和",
          "valueType": "number-series",
          "aggregate": "sum",
          "allowedSources": [
            "device-point"
          ]
        }
      ],
      "filterText": "模块机",
      "settings": {
        "dataSource": "energy",
        "energyMetric": "trend",
        "energyKind": "elec"
      }
    },
    {
      "id": "load-compare",
      "type": "bar-compare",
      "zone": "left",
      "x": 2.4,
      "y": 60.4,
      "w": 18.6,
      "h": 32.6,
      "defaultTitle": "用能分项占比",
      "defaultSubtitle": "ENERGY BREAKDOWN",
      "filterText": "模块机",
      "interfaces": [
        {
          "key": "scope",
          "name": "范围",
          "valueType": "scope",
          "allowedSources": [
            "site",
            "scene-topology"
          ]
        },
        {
          "key": "load",
          "name": "功率",
          "valueType": "number",
          "allowedSources": [
            "device-point"
          ]
        }
      ],
      "settings": {
        "dataSource": "energy",
        "energyMetric": "ranking"
      }
    },
    {
      "id": "plant-capacity",
      "type": "metric-card",
      "zone": "right",
      "x": 79.0,
      "y": 12.6,
      "w": 18.6,
      "h": 18,
      "defaultTitle": "装机参数",
      "defaultSubtitle": "PLANT CAPACITY",
      "interfaces": [
        {
          "key": "main",
          "name": "资产参数",
          "valueType": "number",
          "allowedSources": [
            "asset-attribute"
          ]
        },
        {
          "key": "left",
          "name": "制热量",
          "valueType": "number",
          "allowedSources": [
            "asset-attribute",
            "device-point"
          ]
        },
        {
          "key": "right",
          "name": "压缩机功率",
          "valueType": "number",
          "allowedSources": [
            "asset-attribute",
            "device-point"
          ]
        }
      ],
      "settings": {
        "dataSource": "energy",
        "energyMetric": "carbon"
      }
    },
    {
      "id": "unit-list",
      "type": "device-list",
      "zone": "right",
      "x": 79.0,
      "y": 31.5,
      "w": 18.6,
      "h": 29,
      "defaultTitle": "机组状态",
      "defaultSubtitle": "UNIT STATUS",
      "filterText": "模块机",
      "interfaces": [
        {
          "key": "scope",
          "name": "范围",
          "valueType": "scope",
          "allowedSources": [
            "site",
            "scene-topology"
          ]
        },
        {
          "key": "value",
          "name": "出水温度",
          "valueType": "number",
          "allowedSources": [
            "device-point"
          ]
        },
        {
          "key": "opening",
          "name": "开度",
          "valueType": "number",
          "allowedSources": [
            "device-point"
          ]
        },
        {
          "key": "state",
          "name": "运行状态",
          "valueType": "number",
          "displayType": "boolean",
          "allowedSources": [
            "device-point"
          ]
        }
      ]
    },
    {
      "id": "alarm-ticker",
      "type": "alarm-ticker",
      "zone": "right",
      "x": 79.0,
      "y": 61.4,
      "w": 18.6,
      "h": 31.6,
      "defaultTitle": "告警",
      "defaultSubtitle": "ALARMS",
      "interfaces": []
    }
  ],
  "objectBinding": {
    "matchBy": "objectName",
    "description": "三维对象按 GLB 里的节点名对接。9 台模块机 node 为 1~9，泵为「立式管道离心泵」「立式管道离心泵_2」。只绑平台实时设备，虚拟设备按既有规则失效。",
    "fields": [
      {
        "key": "targetDevice",
        "name": "目标设备",
        "valueType": "realtime-device",
        "required": true
      },
      {
        "key": "nameplatePoints",
        "name": "铭牌测点",
        "valueType": "telemetry-mapping-list",
        "optional": true
      },
      {
        "key": "behaviors",
        "name": "行为",
        "valueType": "action-mapping-list",
        "optional": true
      },
      {
        "key": "controlCommands",
        "name": "启停命令",
        "valueType": "command-list",
        "optional": true
      },
      {
        "key": "status",
        "name": "状态映射",
        "valueType": "status-mapping",
        "optional": true
      }
    ]
  },
  "aiExtension": {
    "editableTargets": [
      "widget.props",
      "widget.layout",
      "widget.style",
      "widget.binding",
      "scene.interaction",
      "scene.layer"
    ],
    "protectedTargets": [
      "templateId",
      "mountPoints.scene",
      "runtime.eventContract"
    ],
    "operations": [
      "add-widget",
      "update-widget",
      "remove-widget",
      "bind-telemetry"
    ],
    "requiresDiffReview": true
  }
}
