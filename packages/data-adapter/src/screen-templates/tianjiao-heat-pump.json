{
  "schemaVersion": "1.0.0",
  "id": "tianjiao-heat-pump",
  "name": "天骄冷热站",
  "version": 18,
  "description": "热泵机组监控大屏：左翼 9 台机组列表，中间三维场景，右翼选中机组与系统汇总，底部功率趋势与加载率对比。系统级点位读网关设备，机组级点位读各模块机。",
  "regions": [
    {
      "id": "title",
      "type": "title",
      "zone": "title",
      "x": 20.0,
      "y": 1.0,
      "w": 60.0,
      "h": 6.5,
      "defaultTitle": "{sceneName} · 冷热站监控",
      "defaultSubtitle": "CHILLED WATER PLANT DIGITAL TWIN",
      "interfaces": []
    },
    {
      "id": "system-power",
      "type": "metric-card",
      "zone": "left",
      "x": 3.13,
      "y": 13.43,
      "w": 11.35,
      "h": 24.12,
      "defaultTitle": "系统功率",
      "defaultSubtitle": "SYSTEM POWER",
      "filterText": "模块机",
      "interfaces": [
        {
          "key": "filter",
          "name": "取数范围",
          "valueType": "scope",
          "allowedSources": [
            "site",
            "scene-topology"
          ]
        },
        {
          "key": "main",
          "name": "系统功率",
          "valueType": "number",
          "allowedSources": [
            "device-point"
          ]
        },
        {
          "key": "left",
          "name": "进水温度",
          "valueType": "number",
          "allowedSources": [
            "asset-attribute",
            "device-point"
          ]
        },
        {
          "key": "right",
          "name": "出水温度",
          "valueType": "number",
          "allowedSources": [
            "asset-attribute",
            "device-point"
          ]
        }
      ]
    },
    {
